# The superuser of the sandbox. Copy this file to sandbox.env (not in Git)
# and the superuser stays the same after every `composer sandbox -- --reset`.
# Variables set in the shell win over this file. Without a password, one is
# generated and shown once.

FROOTBOX_ADMIN_EMAIL=admin@example.test
FROOTBOX_ADMIN_NAME=Admin
# FROOTBOX_ADMIN_PASSWORD='at least 10 characters'

# Own test content after the demo, e.g. a large website, as seed files
# separated by commas, relative to the repo. Keep them in local/, which
# Git ignores.
# FROOTBOX_SANDBOX_SEED=local/large-site.yaml
