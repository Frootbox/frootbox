{
    "name": "frootbox/frootbox",
    "description": "Monorepo of the Frootbox CMS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "frootbox/backend": "^0.1@dev",
        "frootbox/core": "^0.1@dev",
        "frootbox/database": "^0.1@dev",
        "frootbox/forms": "^0.1@dev",
        "frootbox/seo": "^0.1@dev",
        "frootbox/people": "^0.1@dev",
        "frootbox/events": "^0.1@dev",
        "frootbox/collections": "^0.1@dev",
        "frootbox/jobs": "^0.1@dev",
        "frootbox/search": "^0.1@dev",
        "frootbox/statistics": "^0.1@dev",
        "frootbox/news": "^0.1@dev",
        "frootbox/google-fonts": "^0.1@dev",
        "frootbox/webhooks": "^0.1@dev",
        "frootbox/rich-text": "^0.1@dev",
        "frootbox/theme-base": "^0.1@dev",
        "frootbox/theme-bohnenglueck": "^0.1@dev"
    },
    "repositories": [
        { "type": "path", "url": "packages/*", "options": { "symlink": true } },
        { "type": "path", "url": "packages/themes/*", "options": { "symlink": true } },
        { "type": "path", "url": "packages/modules/*", "options": { "symlink": true } },
        { "type": "path", "url": "packages/tools/*", "options": { "symlink": true } }
    ],
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\Backend\\Tests\\": "packages/backend/tests/",
            "Frootbox\\Core\\Tests\\": "packages/core/tests/",
            "Frootbox\\Database\\Tests\\": "packages/database/tests/",
            "Frootbox\\Forms\\Tests\\": "packages/modules/forms/tests/",
            "Frootbox\\Seo\\Tests\\": "packages/modules/seo/tests/",
            "Frootbox\\People\\Tests\\": "packages/modules/people/tests/",
            "Frootbox\\Events\\Tests\\": "packages/modules/events/tests/",
            "Frootbox\\Collections\\Tests\\": "packages/modules/collections/tests/",
            "Frootbox\\Jobs\\Tests\\": "packages/modules/jobs/tests/",
            "Frootbox\\Search\\Tests\\": "packages/modules/search/tests/",
            "Frootbox\\Statistics\\Tests\\": "packages/modules/statistics/tests/",
            "Frootbox\\News\\Tests\\": "packages/modules/news/tests/",
            "Frootbox\\GoogleFonts\\Tests\\": "packages/modules/google-fonts/tests/",
            "Frootbox\\Webhooks\\Tests\\": "packages/modules/webhooks/tests/",
            "Frootbox\\Workbench\\Tests\\": "packages/tools/workbench/tests/",
            "Frootbox\\RichText\\Tests\\": "packages/rich-text/tests/",
            "Frootbox\\ThemeBase\\Tests\\": "packages/themes/base/tests/",
            "Frootbox\\Tools\\PHPStan\\": "tools/phpstan/src/",
            "Frootbox\\Tools\\PHPStan\\Tests\\": "tools/phpstan/tests/"
        }
    },
    "scripts": {
        "cs": "@php vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "stan": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "@php vendor/bin/phpunit",
        "sandbox": "@php tools/sandbox.php",
        "design-doc": "@php tools/design-doc.php",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t sandbox/public sandbox/public/index.php"
        ],
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "frootbox/workbench": "^0.1@dev",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    }
}
