{
    "name": "frootbox/frootbox",
    "description": "Monorepo of the Frootbox CMS",
    "type": "project",
    "license": "LGPL-3.0-only",
    "require": {
        "php": ">=8.5",
        "frootbox/core": "^0.1@dev",
        "frootbox/database": "^0.1@dev"
    },
    "repositories": [
        { "type": "path", "url": "packages/*", "options": { "symlink": true } }
    ],
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\Core\\Tests\\": "packages/core/tests/",
            "Frootbox\\Database\\Tests\\": "packages/database/tests/",
            "Frootbox\\Tools\\PHPStan\\": "tools/phpstan/src/",
            "Frootbox\\Tools\\PHPStan\\Tests\\": "tools/phpstan/tests/"
        }
    },
    "scripts": {
        "cs": "@php vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "stan": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "@php vendor/bin/phpunit",
        "sandbox": "@php tools/sandbox.php",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t sandbox/public"
        ],
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    }
}
