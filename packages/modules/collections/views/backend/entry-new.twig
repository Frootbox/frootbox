{#- A new entry of a collection as a draft (decisions 0220, 0246). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('New entry') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <p class="fb-muted"><a href="{{ path('frootbox.collections.entries') ~ (space ? '?space=' ~ space|url_encode : '') }}">{{ t('Collections') }}</a></p>
            <h1 class="fb-heading-1">{{ t('New entry') }}</h1>
        </div>
    </header>

    <fb-form action="frootbox/collections/entry.create" next="{{ path('frootbox.collections.entries') }}/{id}" done="{{ t('The entry is saved as a draft.') }}">
        <form class="fb-card fb-card--padded fb-stack" novalidate>
            {% if space %}<input type="hidden" name="space" value="{{ space }}">{% endif %}
            {% include '@frootbox/collections/backend/fields.twig' with {language: language, translation: null, slug: false, data: null, image: null, image_value: null, space: space ?? null, editable: true} only %}
            <div class="fb-form__actions">
                {{ ui.button({label: t('Save as a draft'), type: 'submit'}) }}
                {{ ui.button({label: t('Cancel'), variant: 'ghost', href: path('frootbox.collections.entries') ~ (space ? '?space=' ~ space|url_encode : '')}) }}
            </div>
        </form>
    </fb-form>
</div>
{% endblock %}
