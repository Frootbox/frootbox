{#- The screen "News": the articles, newest first (decision 0220). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('News') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <h1 class="fb-heading-1">{{ t('News') }}</h1>
            <p class="fb-muted">{{ t('Articles with a date, such as announcements, press releases or blog posts.') }}</p>
        </div>
        <div class="fb-cluster">
            {{ ui.button({label: t('Categories'), href: path('frootbox.news.articles.categories'), variant: 'outline'}) }}
            {% if can('frootbox/news/article.create') %}{{ ui.button({label: t('New article'), href: path('frootbox.news.articles.new'), icon: 'plus'}) }}{% endif %}
        </div>
    </header>

    <section class="fb-card" aria-labelledby="news-articles-title">
        <div class="fb-card__header">
            <h2 class="fb-heading-4" id="news-articles-title">{{ t('Articles') }}</h2>
            {{ ui.badge('neutral', list.total) }}
        </div>
        <form class="fb-card__body fb-cluster" method="get" action="{{ path('frootbox.news.articles') }}" role="search">
            {{ ui.field({label: t('Search'), name: 'q', id: 'news-search', type: 'search', value: search, placeholder: t('Title')}) }}
            {{ ui.button({label: t('Search'), variant: 'outline', type: 'submit', icon: 'search'}) }}
        </form>
        {% if list.items is empty %}
        <div class="fb-card__body">
            {% if search %}
                {{ ui.empty({icon: 'news', title: t('Nothing found'), text: t('Try another search.')}) }}
            {% else %}
                {{ ui.empty({icon: 'news', title: t('No articles yet'), text: t('Write the first one. It stays a draft until you publish it.'), action: can('frootbox/news/article.create') ? {label: t('New article'), href: path('frootbox.news.articles.new'), icon: 'plus'} : null}) }}
            {% endif %}
        </div>
        {% else %}
        <ul>
            {%- for article in list.items %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <a class="fb-list__title fb-list__link" href="{{ path('frootbox.news.articles.show', {id: article.id}) }}">{{ article.title ?: t('Without a title') }}</a>
                    <span class="fb-list__meta">{{ ui.time(article.date) }}{% if article.languages|length > 1 %} · {{ article.languages|map(code => code|upper)|join(', ') }}{% endif %}</span>
                </span>
                {% if article.publishAt or article.unpublishAt %}{{ ui.status('scheduled') }}{% endif %}
                {{ ui.status(article.status.value) }}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
    </section>
    {% if list.pages > 1 %}
    <nav class="fb-cluster" aria-label="{{ t('Pages of the list') }}">
        {% if list.page > 1 %}{{ ui.button({label: t('Newer'), href: path('frootbox.news.articles') ~ '?' ~ {q: search ?: null, page: list.page - 1}|url_encode, variant: 'outline', small: true}) }}{% endif %}
        <span class="fb-muted">{{ t('Page {page} of {pages}', {page: list.page, pages: list.pages}) }}</span>
        {% if list.page < list.pages %}{{ ui.button({label: t('Older'), href: path('frootbox.news.articles') ~ '?' ~ {q: search ?: null, page: list.page + 1}|url_encode, variant: 'outline', small: true}) }}{% endif %}
    </nav>
    {% endif %}
</div>
{% endblock %}
