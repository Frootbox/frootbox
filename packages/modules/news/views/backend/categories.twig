{#- The categories of the news: title and address by language (decision 0220). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}
{% set refresh = 'news-categories' %}
{% set several = languages|length > 1 %}

{% macro texts(prefix, id, languages, category, several, editable) %}
    {% import '@backend/ui.twig' as ui %}
    {% for language in languages %}
        {% set code = language.code %}
        {% set fields %}
            {{ ui.field({label: t('Title'), name: 'translations.' ~ code ~ '.title', id: prefix ~ id ~ '-' ~ code ~ '-title', value: category ? category.title(code) ?? '' : '', required: not several or loop.first, optional: several and not loop.first, disabled: not editable, attrs: {lang: code, dir: language.direction.value, maxlength: 100}}) }}
            {% if category %}
            {{ ui.field({label: t('Address'), name: 'translations.' ~ code ~ '.slug', id: prefix ~ id ~ '-' ~ code ~ '-slug', value: category.slug(code) ?? '', optional: true, disabled: not editable, attrs: {dir: 'ltr', maxlength: 100}, hint: t('Used in the filter of the list, e.g. ?category=press.')}) }}
            {% endif %}
        {% endset %}
        {% if several %}
        <fieldset class="fb-fieldset">
            <legend class="fb-fieldset__legend" lang="{{ code }}">{{ language.title }}</legend>
            {{ fields }}
        </fieldset>
        {% else %}
            {{ fields }}
        {% endif %}
    {% endfor %}
{% endmacro %}

{% block title %}{{ t('Categories') }} · {{ t('News') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg" id="news-categories">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <p class="fb-muted"><a href="{{ path('frootbox.news.articles') }}">{{ t('News') }}</a></p>
            <h1 class="fb-heading-1" tabindex="-1" data-fb-focus>{{ t('Categories') }}</h1>
            <p class="fb-muted">{{ t('Topics of the articles, such as events or press. Visitors can filter the list by them.') }}</p>
        </div>
    </header>

    {% set editable = can('frootbox/news/category.update') %}
    {% for category in categories %}
    {% set name = category.title(default.code) ?? category.translations|keys|map(code => category.title(code))|filter(v => v)|first ?: category.id %}
    <section class="fb-card fb-card--padded fb-stack" aria-labelledby="category-{{ category.id }}-title">
        <h2 class="fb-heading-4" id="category-{{ category.id }}-title">{{ name }}</h2>
        <fb-form action="frootbox/news/category.update" refresh="{{ refresh }}" done="{{ t('Saved') }}">
            <form class="fb-stack" novalidate>
                <input type="hidden" name="id" value="{{ category.id }}">
                {{ _self.texts('category-', category.id, languages, category, several, editable) }}
                <div class="fb-form__actions">
                    {% if editable %}{{ ui.button({label: t('Save'), type: 'submit', saves: true}) }}{% endif %}
                    {% if can('frootbox/news/category.delete') %}{{ ui.button({label: t('Delete'), variant: 'danger', attrs: {commandfor: 'category-' ~ category.id ~ '-delete', command: 'show-modal', 'aria-label': t('Delete {title}', {title: name})}}) }}{% endif %}
                </div>
            </form>
        </fb-form>
        {% if can('frootbox/news/category.delete') %}
        <dialog class="fb-dialog" id="category-{{ category.id }}-delete" aria-labelledby="category-{{ category.id }}-delete-title">
            <fb-form action="frootbox/news/category.delete" refresh="{{ refresh }}" done="{{ t('The category is deleted.') }}">
                <form novalidate>
                    <input type="hidden" name="id" value="{{ category.id }}">
                    <div class="fb-dialog__body">
                        <h2 class="fb-dialog__title" id="category-{{ category.id }}-delete-title">{{ t('Delete {title}?', {title: name}) }}</h2>
                        <p>{{ t('The articles stay, they just lose this category.') }}</p>
                    </div>
                    <div class="fb-dialog__actions">
                        {{ ui.button({label: t('Cancel'), variant: 'outline', attrs: {commandfor: 'category-' ~ category.id ~ '-delete', command: 'close', autofocus: true}}) }}
                        {{ ui.button({label: t('Delete for good'), variant: 'danger-solid', type: 'submit'}) }}
                    </div>
                </form>
            </fb-form>
        </dialog>
        {% endif %}
    </section>
    {% else %}
    {{ ui.empty({icon: 'news', title: t('No categories yet'), text: t('Articles do not need one. Create categories if visitors should filter by topic.')}) }}
    {% endfor %}

    {% if can('frootbox/news/category.create') %}
    <section class="fb-card fb-card--padded fb-stack" aria-labelledby="category-new-title">
        <h2 class="fb-heading-4" id="category-new-title">{{ t('New category') }}</h2>
        <fb-form action="frootbox/news/category.create" refresh="{{ refresh }}" done="{{ t('The category is created.') }}">
            <form class="fb-stack" novalidate>
                {{ _self.texts('category-new', '', languages, null, several, true) }}
                <div class="fb-form__actions">{{ ui.button({label: t('Create the category'), type: 'submit'}) }}</div>
            </form>
        </fb-form>
    </section>
    {% endif %}
</div>
{% endblock %}
