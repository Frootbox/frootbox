{# frootbox
title: Call to action
description: A coloured band with a heading, a sentence and a button at the end of a page.
group: callout
keywords: [Call to action, Call to Action, Button]
options:
  anchor: { type: text, label: Anchor for the navigation }
fields:
  title: { type: headline, label: Heading, placeholder: "What do you invite people to?" }
  text: { type: text, label: Text, optional: true, placeholder: "A sentence that makes people click" }
  button: { type: link, label: Button }
#}
<section class="section"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap cta">
    <div>{{ heading('title', 0, {class: 'cta__title'}) }}<p>{{ field('text') }}</p></div>
    <div class="button-field">{{ field('button') }}</div>
  </div>
</section>
