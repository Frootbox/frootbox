{# frootbox
title: Equal width
options:
  anchor: { type: text, label: Anchor for the navigation }
  ratio:
    type: choice
    label: Ratio
    choices: { even: '1 : 1', wide: '2 : 1' }
#}
<section class="section"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap columns columns--{{ options.ratio }}">
    <div>{{ area('left') }}</div>
    <div>{{ area('right') }}</div>
  </div>
</section>
