{# frootbox
title: FAQ
description: Fragen und Antworten zum Aufklappen.
group: list
keywords: [Fragen, Antworten, Akkordeon]
options:
  anchor: { type: text, label: Anker für die Navigation }
  open:
    type: boolean
    label: Erste Antwort geöffnet
fields:
  title: { type: headline, label: Überschrift, placeholder: "Häufige Fragen" }
  items:
    type: list
    label: Fragen
    min: 1
    start: 3
    fields:
      question: { type: headline, label: Frage, placeholder: "Eine Frage, die oft gestellt wird" }
      answer: { type: richtext, label: Antwort, placeholder: "Die Antwort in ein paar Sätzen" }
#}
<section class="section faq"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap faq__inner">
    <header class="section__head">{{ heading('title', 0, {class: 'section__title'}) }}</header>
    {% for item in field('items') %}
      <details name="faq"{{ options.open and loop.first ? ' open' }}><summary>{{ item.heading('question', 1, {class: 'faq__question'}) }}</summary><div class="faq__answer">{{ item.field('answer') }}</div></details>
    {% endfor %}
  </div>
</section>
