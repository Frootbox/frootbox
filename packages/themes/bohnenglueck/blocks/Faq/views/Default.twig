{# frootbox
title: FAQ
description: Questions and answers to expand.
group: list
keywords: [Questions, Answers, Accordion]
options:
  anchor: { type: text, label: Anchor for the navigation }
  open:
    type: boolean
    label: First answer open
fields:
  title: { type: headline, label: Heading, placeholder: "Frequent questions" }
  items:
    type: list
    label: Questions
    min: 1
    start: 3
    fields:
      question: { type: headline, label: Question, placeholder: "A question people often ask" }
      answer: { type: richtext, label: Answer, placeholder: "The answer in a few sentences" }
#}
<section class="section faq"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap faq__inner">
    <header class="section__head">{{ heading('title', 0, {class: 'section__title'}) }}</header>
    {% for item in field('items') %}
      <details name="faq"{{ options.open and loop.first ? ' open' }}><summary>{{ item.heading('question', 1, {class: 'faq__question'}) }}</summary><div class="faq__answer">{{ item.field('answer') }}</div></details>
    {% endfor %}
  </div>
</section>
