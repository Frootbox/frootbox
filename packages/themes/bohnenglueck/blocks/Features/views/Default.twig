{# frootbox
title: Vorteile
description: Überschrift mit Einleitung und einem Raster aus kurzen Punkten.
group: list
keywords: [Vorteile, Merkmale, Raster]
options:
  anchor: { type: text, label: Anker für die Navigation }
  columns:
    type: choice
    label: Spalten
    choices: { 2: Zwei, 3: Drei, 4: Vier }
    default: 3
fields:
  title: { type: headline, label: Überschrift, placeholder: "Was macht Dich besonders?" }
  intro: { type: text, label: Einleitung, optional: true, placeholder: "Ein Satz, der zu den Punkten hinführt" }
  items:
    type: list
    label: Punkte
    min: 1
    max: 8
    start: 3
    fields:
      icon: { type: headline, label: Symbol, optional: true, maxLength: 4, description: Ein Emoji, placeholder: "✨" }
      title: { type: headline, label: Titel, placeholder: "Ein Vorteil in wenigen Worten" }
      text: { type: text, label: Text, multiline: true, optional: true, placeholder: "Ein, zwei Sätze, was dahintersteckt" }
#}
<section class="section features"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap">
    <header class="section__head"><h2>{{ field('title') }}</h2><p>{{ field('intro') }}</p></header>
    <ul class="features__grid" style="--columns: {{ options.columns }}">
      {% for item in field('items') %}
        <li class="features__item"><span class="features__icon" aria-hidden="true">{{ item.field('icon') }}</span><h3>{{ item.field('title') }}</h3><p>{{ item.field('text') }}</p></li>
      {% endfor %}
    </ul>
  </div>
</section>
