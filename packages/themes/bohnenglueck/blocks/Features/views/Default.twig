{# frootbox
title: Benefits
description: A heading with an introduction and a grid of short points.
group: list
keywords: [Benefits, Features, Grid]
options:
  anchor: { type: text, label: Anchor for the navigation }
  columns:
    type: choice
    label: Columns
    choices: { 2: Two, 3: Three, 4: Four }
    default: 3
fields:
  title: { type: headline, label: Heading, placeholder: "What makes you special?" }
  intro: { type: text, label: Introduction, optional: true, placeholder: "A sentence that leads to the points" }
  items:
    type: list
    label: Points
    min: 1
    max: 8
    start: 3
    fields:
      icon: { type: headline, label: Symbol, optional: true, maxLength: 4, description: An emoji, placeholder: "✨" }
      title: { type: headline, label: Title, placeholder: "A benefit in a few words" }
      text: { type: text, label: Text, multiline: true, optional: true, placeholder: "A sentence or two on what is behind it" }
#}
<section class="section features"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap">
    <header class="section__head">{{ heading('title', 0, {class: 'section__title'}) }}<p>{{ field('intro') }}</p></header>
    <ul class="features__grid" style="--columns: {{ options.columns }}">
      {% for item in field('items') %}
        <li class="features__item"><span class="features__icon" aria-hidden="true">{{ item.field('icon') }}</span>{{ item.heading('title', 1, {class: 'features__title'}) }}<p>{{ item.field('text') }}</p></li>
      {% endfor %}
    </ul>
  </div>
</section>
