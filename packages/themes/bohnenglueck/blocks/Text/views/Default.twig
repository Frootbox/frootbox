{# frootbox
title: Text
description: Formatted running text with an optional heading.
group: text
keywords: [Paragraph, Running text]
options:
  anchor: { type: text, label: Anchor for the navigation }
  width:
    type: choice
    label: Width
    choices: { narrow: Narrow, wide: Wide }
fields:
  title: { type: headline, label: Heading, optional: true }
  body: { type: richtext, label: Text, placeholder: "Write your text here" }
#}
<section class="text text--{{ options.width }}"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  {{ heading('title', 0, {class: 'text__title'}) }}
  <div class="text__body">{{ field('body') }}</div>
</section>
