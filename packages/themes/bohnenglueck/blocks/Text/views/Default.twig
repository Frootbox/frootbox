{# frootbox
title: Text
description: Formatierter Fließtext mit optionaler Überschrift.
options:
  anchor: { type: text, label: Anker für die Navigation }
  width:
    type: choice
    label: Breite
    choices: { narrow: Schmal, wide: Breit }
fields:
  title: { type: headline, label: Überschrift, optional: true }
  body: { type: richtext, label: Text, placeholder: "Schreib hier Deinen Text" }
#}
<section class="text text--{{ options.width }}"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <h2>{{ field('title') }}</h2>
  <div class="text__body">{{ field('body') }}</div>
</section>
