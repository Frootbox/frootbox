{# frootbox
title: Zentriert
description: Alles mittig, für den ersten Eindruck.
options:
  anchor: { type: text, label: Anker für die Navigation }
  tone:
    type: choice
    choices: { light: Hell, dark: Dunkel }
#}
<section class="hero hero--center hero--{{ options.tone }}"{% if options.anchor %} id="{{ options.anchor }}"{% endif %}>
  <div class="wrap hero__inner">
    <p class="eyebrow">{{ field('eyebrow') }}</p>
    <h1>{{ field('title') }}</h1>
    <p class="hero__text">{{ field('text') }}</p>
    <div class="hero__actions">
      <span class="button-field">{{ field('button') }}</span>
      <span class="button-field button-field--ghost">{{ field('secondary') }}</span>
    </div>
  </div>
</section>
