{# frootbox
title: Zitat
description: Ein Kundenstimme oder Leitsatz, groß gesetzt.
fields:
  quote: { type: text, label: Zitat, multiline: true, placeholder: "Was jemand über Dich gesagt hat" }
  author: { type: headline, label: Name, placeholder: "Wer es gesagt hat" }
  role: { type: headline, label: Rolle, optional: true }
#}
<figure class="quote">
  <blockquote><p>{{ field('quote') }}</p></blockquote>
  <figcaption><strong>{{ field('author') }}</strong>{% if value('role') %}<span>{{ field('role') }}</span>{% endif %}</figcaption>
</figure>
