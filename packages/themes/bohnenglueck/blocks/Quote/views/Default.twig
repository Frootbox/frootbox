{# frootbox
title: Quote
description: A customer’s voice or a motto, set large.
group: text
keywords: [Customer voice, Testimonial, Motto]
fields:
  quote: { type: text, label: Quote, multiline: true, placeholder: "What someone said about you" }
  author: { type: headline, label: Name, placeholder: "Who said it" }
  role: { type: headline, label: Role, optional: true }
#}
<figure class="quote">
  <blockquote><p>{{ field('quote') }}</p></blockquote>
  <figcaption><strong>{{ field('author') }}</strong><span>{{ field('role') }}</span></figcaption>
</figure>
