                    "fields": {
                      "title": "Die Rösterei",
                      "body": {
                        "type": "doc",
                        "content": [
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "Seit 2014 rösten wir in einem alten Kontorhaus direkt am Hafen. Was als "
                              },
                              {
                                "type": "text",
                                "text": "Hobby in der Küche",
                                "marks": [
                                  {
                                    "type": "bold"
                                  }
                                ]
                              },
                              {
                                "type": "text",
                                "text": " begann, ist heute eine kleine Manufaktur mit sechs Leuten."
                              }
                            ]
                          },
                          {
                            "type": "bulletList",
                            "content": [
                              {
                                "type": "listItem",
                                "content": [
                                  {
                                    "type": "paragraph",
                                    "content": [
                                      {
                                        "type": "text",
                                        "text": "Espresso, Filter und saisonale Single Origins"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "type": "listItem",
                                "content": [
                                  {
                                    "type": "paragraph",
                                    "content": [
                                      {
                                        "type": "text",
                                        "text": "Röstkurse jeden ersten Samstag im Monat"
                                      }
                                    ]
                                  }
                                ]
                              },
                              {
                                "type": "listItem",
                                "content": [
                                  {
                                    "type": "paragraph",
                                    "content": [
                                      {
                                        "type": "text",
                                        "text": "Café mit 20 Plätzen, Mo–Sa ab 8 Uhr"
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "type": "paragraph",
                            "content": [
                              {
                                "type": "text",
                                "text": "Mehr über unsere Partner liest Du im "
                              },
                              {
                                "type": "text",
                                "text": "Herkunfts-Blog",
                                "marks": [
                                  {
                                    "type": "link",
                                    "attrs": {
                                      "href": "https://example.com/blog"
                                    }
                                  }
                                ]
                              },
                              {
                                "type": "text",
                                "text": "."
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                ],
                "right": [
                  {
                    "block": "frootbox/theme-bohnenglueck/Quote",
                    "fields": {
                      "quote": "Der beste Espresso, den ich außerhalb von Italien getrunken habe. Und die Leute sind einfach herzlich.",
                      "author": "Mara Lindqvist",
                      "role": "Stammgast seit 2016"
                    }
                  }
                ]
              }
            },
            {
              "block": "frootbox/theme-bohnenglueck/Faq",
              "options": {
                "anchor": "faq",
                "open": true
              },
              "fields": {
                "title": "Häufige Fragen",
                "items": [
                  {
                    "question": "Welche Mahlgrade bietet Ihr an?",
                    "answer": {
                      "type": "doc",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Ganze Bohne, "
                            },
                            {
                              "type": "text",
                              "text": "Siebträger",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": ", Filter, French Press und Mokka. Im Zweifel: ganze Bohne und frisch mahlen."
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "question": "Wie lange ist der Kaffee haltbar?",
                    "answer": {
                      "type": "doc",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Am besten schmeckt er 1 bis 6 Wochen nach der Röstung. Luftdicht, kühl und dunkel lagern, nicht im Kühlschrank."
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "question": "Kann ich vor Ort probieren?",
                    "answer": {
                      "type": "doc",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Ja! Im Café gibt es jeden Tag zwei Sorten zum Probieren, kostenlos."
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "block": "frootbox/theme-bohnenglueck/Cta",
