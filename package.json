{
  "name": "frootbox-monorepo",
  "private": true,
  "description": "Browser tests and the npm workspaces of Frootbox",
  "license": "LGPL-3.0-only",
  "scripts": {
    "build": "npm run build --workspace=packages/backend",
    "watch": "npm run watch --workspace=packages/backend",
    "lint:css": "npm run lint:css --workspace=packages/backend",
    "test:e2e": "playwright test --project=e2e --project=protection",
    "test:visual": "node tools/visual.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "workspaces": [
    "packages/backend"
  ]
}
