<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".cache/phpunit"
         colors="true"
         executionOrder="random"
         requireCoverageMetadata="true"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="backend">
            <directory>packages/backend/tests</directory>
        </testsuite>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="database">
            <directory>packages/database/tests</directory>
        </testsuite>
        <testsuite name="forms">
            <directory>packages/modules/forms/tests</directory>
        </testsuite>
        <testsuite name="people">
            <directory>packages/modules/people/tests</directory>
        </testsuite>
        <testsuite name="events">
            <directory>packages/modules/events/tests</directory>
        </testsuite>
        <testsuite name="collections">
            <directory>packages/modules/collections/tests</directory>
        </testsuite>
        <testsuite name="jobs">
            <directory>packages/modules/jobs/tests</directory>
        </testsuite>
        <testsuite name="search">
            <directory>packages/modules/search/tests</directory>
        </testsuite>
        <testsuite name="statistics">
            <directory>packages/modules/statistics/tests</directory>
        </testsuite>
        <testsuite name="seo">
            <directory>packages/modules/seo/tests</directory>
        </testsuite>
        <testsuite name="news">
            <directory>packages/modules/news/tests</directory>
        </testsuite>
        <testsuite name="google-fonts">
            <directory>packages/modules/google-fonts/tests</directory>
        </testsuite>
        <testsuite name="captcha-recaptcha">
            <directory>packages/modules/captcha-recaptcha/tests</directory>
        </testsuite>
        <testsuite name="webhooks">
            <directory>packages/modules/webhooks/tests</directory>
        </testsuite>
        <testsuite name="workbench">
            <directory>packages/tools/workbench/tests</directory>
        </testsuite>
        <testsuite name="migrate-frootbox1">
            <directory>packages/tools/migrate-frootbox1/tests</directory>
        </testsuite>
        <testsuite name="rich-text">
            <directory>packages/rich-text/tests</directory>
        </testsuite>
        <testsuite name="theme-base">
            <directory>packages/themes/base/tests</directory>
        </testsuite>
        <testsuite name="tools">
            <directory>tools/phpstan/tests</directory>
            <exclude>tools/phpstan/tests/data</exclude>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>packages/backend/src</directory>
            <directory>packages/core/src</directory>
            <directory>packages/database/src</directory>
            <directory>packages/modules/forms/src</directory>
            <directory>packages/modules/people/src</directory>
            <directory>packages/modules/events/src</directory>
            <directory>packages/modules/collections/src</directory>
            <directory>packages/modules/jobs/src</directory>
            <directory>packages/modules/search/src</directory>
            <directory>packages/modules/statistics/src</directory>
            <directory>packages/modules/seo/src</directory>
            <directory>packages/modules/news/src</directory>
            <directory>packages/modules/google-fonts/src</directory>
            <directory>packages/modules/captcha-recaptcha/src</directory>
            <directory>packages/modules/webhooks/src</directory>
            <directory>packages/tools/workbench/src</directory>
            <directory>packages/tools/migrate-frootbox1/src</directory>
            <directory>packages/rich-text/src</directory>
        </include>
    </source>

    <php>
        <ini name="error_log" value="/dev/null"/>
        <env name="DATABASE_URL" value="pdo-sqlite:///:memory:" force="false"/>
    </php>
</phpunit>
